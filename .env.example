APP_NAME="TWCA Church"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ASSET_URL=

# Public-facing URL used for newsletter tracking links (open pixel, click, unsubscribe).
# Set this to your live domain so email clients can reach the tracking endpoints.
# Example: NEWSLETTER_PUBLIC_URL=https://twca.org
NEWSLETTER_PUBLIC_URL=http://localhost

# Shared secret that the newsletter service must send as the X-Webhook-Secret header
# when calling POST /newsletter/webhook. Generate with: php -r "echo bin2hex(random_bytes(32));"
# Leave empty ONLY if the webhook is never used; the endpoint rejects requests without a valid secret.
NEWSLETTER_WEBHOOK_SECRET=

# Comma-separated list of origins allowed to call the JSON API (e.g. a separate frontend domain).
# When empty, defaults to APP_URL (same-origin API consumption).
# Example: CORS_ALLOWED_ORIGINS=https://app.twcaglobal.org,https://twcaglobal.org
CORS_ALLOWED_ORIGINS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Default application timezone (e.g. Africa/Lagos for WAT).
APP_TIMEZONE=Africa/Lagos

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8
DB_COLLATION=utf8_unicode_ci

# Cloudflare R2 Storage Configuration (used when FILESYSTEM_DISK=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail Configuration ─────────────────────────────────────────────
# Choices for MAIL_MAILER: smtp, resend, mailgun, ses, postmark, log
MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend API key (required when MAIL_MAILER=resend) — get yours at https://resend.com
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Payment Gateway Credentials ─────────────────────────────────────
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

