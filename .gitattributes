* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# Batch / PowerShell (Windows-native tools expect CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.ttf binary
*.woff binary
*.woff2 binary
*.otf binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.sqlite binary
*.db binary

# Laravel runtime files — never normalize
/storage/framework/cache/** binary
/storage/framework/sessions/** binary
/storage/framework/views/** binary
/storage/logs/*.log binary

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
